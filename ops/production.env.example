# Copy to the deployment host as /home/ubuntu/postiva/.env; replace every placeholder.
# Store the real file with owner root/ubuntu and mode 0600. Never commit it or paste it into tickets/logs.
POSTIVA_DB_NAME=postiva
POSTIVA_DB_URL=jdbc:postgresql://postgres:5432/postiva
POSTIVA_DB_USERNAME=postiva_app
POSTIVA_DB_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD

# Example private subnet only: check the host/VPC routes and choose a non-overlapping range before use.
POSTIVA_DOCKER_SUBNET=172.28.240.0/24
POSTIVA_PROXY_IP=172.28.240.2

POSTIVA_FRONTEND_ORIGIN=https://postiva.store
POSTIVA_CORS_ALLOWED_ORIGIN_PATTERNS=
POSTIVA_PUBLIC_BASE_URL=https://postiva.store
POSTIVA_META_PUBLIC_BASE_URL=https://postiva.store

# Generate independent random values of at least 32 UTF-8 bytes; back up the encryption keys separately.
POSTIVA_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_32_BYTES_OR_MORE
POSTIVA_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_OF_32_BYTES_OR_MORE
POSTIVA_MFA_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_OF_32_BYTES_OR_MORE
POSTIVA_MEDIA_SIGNING_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_OF_32_BYTES_OR_MORE

# Compose derives the trusted proxy as POSTIVA_PROXY_IP/32; keep backend private and overwrite forwarded headers.
POSTIVA_LOGIN_ATTEMPTS_PER_15_MINUTES=10

POSTIVA_ADMIN_BOOTSTRAP_ENABLED=false
POSTIVA_ADMIN_BOOTSTRAP_EMAIL=
POSTIVA_ADMIN_BOOTSTRAP_PASSWORD=
POSTIVA_ADMIN_BOOTSTRAP_FULL_NAME=Postiva Administrator

OPENAI_API_KEY=REPLACE_WITH_OPENAI_PROJECT_KEY
OPENAI_MODEL=gpt-6-luna
POSTIVA_AI_ENABLED=true
POSTIVA_AI_DAILY_BUDGET_USD=10.00
POSTIVA_AI_MONTHLY_BUDGET_USD=100.00
POSTIVA_AI_BUDGET_WARNING_PERCENT=80

# Keep disabled until merchant account, live webhook and refund process are verified.
POSTIVA_BILLING_ENABLED=false
POSTIVA_PRO_PRICE_VND=0
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
POSTIVA_BILLING_RETURN_URL=
POSTIVA_BILLING_CANCEL_URL=
POSTIVA_BILLING_REFUND_POLICY_URL=

META_APP_SECRET=
THREADS_APP_SECRET=
INSTAGRAM_APP_SECRET=
META_API_VERSION=v26.0
THREADS_API_VERSION=v26.0
INSTAGRAM_API_VERSION=v26.0

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_REAL_SENDER_ACCOUNT
MAIL_PASSWORD=REPLACE_WITH_PROVIDER_APP_PASSWORD
MAIL_FROM=no-reply@postiva.store
POSTIVA_MAIL_ENABLED=true

POSTIVA_UPLOAD_DIR=uploads/images
POSTIVA_MEDIA_PUBLIC_LINK_TTL_SECONDS=86400
POSTIVA_SCHEDULER_MAX_ATTEMPTS=4
POSTIVA_SCHEDULER_LEASE_SECONDS=1800
