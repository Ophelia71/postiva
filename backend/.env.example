POSTIVA_DB_URL=jdbc:postgresql://localhost:5432/postiva
POSTIVA_DB_USERNAME=
# Set a unique local database password; never reuse this value in production.
POSTIVA_DB_PASSWORD=
# Existing databases require an explicit Flyway baseline before the first upgrade.
# See ../database/README.md; Hibernate validates schema instead of changing it.
# Internal provisioning only. Enable for one startup after setting unique credentials,
# then disable and remove the bootstrap password from the runtime environment.
POSTIVA_ADMIN_BOOTSTRAP_ENABLED=false
POSTIVA_ADMIN_BOOTSTRAP_EMAIL=
POSTIVA_ADMIN_BOOTSTRAP_PASSWORD=
POSTIVA_ADMIN_BOOTSTRAP_FULL_NAME=Postiva Administrator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: OpenAI Organization Admin key + dedicated project ID enables authoritative daily cost reconciliation.
OPENAI_ADMIN_API_KEY=
OPENAI_PROJECT_ID=
# Free/Pro generations per rolling 30-day period. Pro is activated only by a verified subscription.
POSTIVA_FREE_AI_LIMIT=30
POSTIVA_PRO_AI_LIMIT=300
# payOS uses live VND bank transfers and has no separate sandbox. Leave off until
# merchant verification, approved price/policy, HTTPS return URLs and live E2E checks are complete.
POSTIVA_BILLING_ENABLED=false
POSTIVA_PRO_PRICE_VND=149000
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Simplest way to sell Pro: a VietQR bank transfer to your own account, confirmed by an admin
# in Admin > Thanh toán. Used whenever payOS is not configured. Leave the account empty to turn it off.
POSTIVA_BANK_CODE=TPB
POSTIVA_BANK_ACCOUNT_NO=
POSTIVA_BANK_ACCOUNT_NAME=
# Optional: SePay (sepay.vn) watches the account so matching transfers confirm by themselves.
# Simplest: the API token from my.sepay.vn > Cấu hình công ty > API Access; Postiva asks SePay itself
# while a buyer waits (no public address needed). Keep it secret: it can read the whole account history.
POSTIVA_SEPAY_API_TOKEN=
# Or/also a webhook: <public backend>/api/billing/sepay/webhook, authentication "API Key" with this value.
POSTIVA_SEPAY_API_KEY=
# Defaults: <POSTIVA_FRONTEND_ORIGIN>/app/billing for return and cancel, <origin>/refund-policy for the policy.
# Set them only to point somewhere else; an empty value here would override the default.
# POSTIVA_BILLING_RETURN_URL=
# POSTIVA_BILLING_CANCEL_URL=
# POSTIVA_BILLING_REFUND_POLICY_URL=
POSTIVA_AI_GLOBAL_DAILY_ATTEMPTS=100
POSTIVA_AI_USER_DAILY_ATTEMPTS=20
# Operational AI spend guard (USD). Update token prices whenever OPENAI_MODEL changes.
POSTIVA_AI_ENABLED=true
POSTIVA_AI_DAILY_BUDGET_USD=10.00
POSTIVA_AI_MONTHLY_BUDGET_USD=100.00
POSTIVA_AI_INPUT_USD_PER_MILLION_TOKENS=0.10
POSTIVA_AI_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.01
POSTIVA_AI_CACHE_WRITE_INPUT_USD_PER_MILLION_TOKENS=0.125
POSTIVA_AI_OUTPUT_USD_PER_MILLION_TOKENS=0.50
POSTIVA_AI_COST_RESERVATION_MULTIPLIER=2.0
POSTIVA_AI_MAX_INPUT_TOKENS=32000
POSTIVA_AI_MAX_OUTPUT_TOKENS=1800
POSTIVA_AI_BUDGET_WARNING_PERCENT=80
POSTIVA_FRONTEND_ORIGIN=http://localhost:5173
POSTIVA_CORS_ALLOWED_ORIGIN_PATTERNS=
META_APP_SECRET=
POSTIVA_META_PUBLIC_BASE_URL=https://api.example.com
META_API_VERSION=v26.0

THREADS_APP_SECRET=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v26.0
# Stable random secret with at least 32 UTF-8 bytes; changing it invalidates active sessions.
POSTIVA_JWT_SECRET=
POSTIVA_JWT_EXPIRATION_MILLISECONDS=86400000
# Stable random secret with at least 32 UTF-8 bytes. Store outside the repository.
POSTIVA_TOKEN_ENCRYPTION_KEY=
# Stable secret with at least 32 UTF-8 bytes. Back up securely; changing it requires MFA re-enrollment.
POSTIVA_MFA_ENCRYPTION_KEY=
# Name of the entry in the authenticator app. Use a different one per environment, e.g. "Postiva Local".
POSTIVA_MFA_ISSUER=Postiva
POSTIVA_UPLOAD_DIR=
# Public HTTPS URL pointing to THIS backend, required for Instagram/Threads media.
# The dev profile uses this too; set POSTIVA_LOCAL_PUBLIC_BASE_URL only to override it locally.
POSTIVA_PUBLIC_BASE_URL=
# Stable random secret with at least 32 UTF-8 bytes; changing it invalidates media URLs already sent to Meta.
POSTIVA_MEDIA_SIGNING_SECRET=
POSTIVA_MEDIA_PUBLIC_LINK_TTL_SECONDS=86400
POSTIVA_PUBLISH_DELAY_MS=
POSTIVA_SCHEDULER_BATCH_SIZE=1
POSTIVA_SCHEDULER_MAX_ATTEMPTS=4
POSTIVA_SCHEDULER_LEASE_SECONDS=1800
POSTIVA_SCHEDULER_BACKOFF_BASE_SECONDS=60
POSTIVA_SCHEDULER_BACKOFF_MAX_SECONDS=3600
# Legacy schedule_time was sent by the browser as ISO UTC before its offset was dropped.
POSTIVA_LEGACY_SCHEDULE_TIME_ZONE=UTC
# Legacy created/updated/published timestamps may use the old JVM timezone.
# Use UTC for the old Docker runtime; use Asia/Ho_Chi_Minh if the old app ran on a Vietnam-time host.
POSTIVA_LEGACY_TIMESTAMP_TIME_ZONE=UTC

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
POSTIVA_MAIL_ENABLED=true

POSTIVA_LOGIN_ATTEMPTS_PER_15_MINUTES=10
# Only addresses/CIDRs of controlled reverse proxies that overwrite X-Real-IP. Empty = trust no proxy.
POSTIVA_TRUSTED_PROXY_ADDRESSES=
